# Copy to .env and fill in your key:
#   cp .env.example .env

# AI provider used by the server when the frontend doesn't override it.
# Options: cursor (default) | openai
AI_PROVIDER=cursor

# Cursor Agent SDK key (used when provider = cursor)
CURSOR_API_KEY=

# OpenAI / ChatGPT (used when provider = openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

API_PORT=8787

# Stock universe: egx30 (default, data/egx30.js) | all (all 224 in data/symbols.js). SYMBOLS=… overrides both.
# UNIVERSE=egx30

# Frontend (Vite) — used when building for GitHub Pages
# VITE_API_BASE=https://egx-api.onrender.com

# Frontend static login (optional — defaults shown)
# VITE_AUTH_EMAIL=admin@egx.local
# VITE_AUTH_PASSWORD=egx1234
# Dev backdoor value for ?devbypass=… (default: 1)
# VITE_AUTH_BYPASS=1

# Local PostgreSQL (Phase 2D). Optional: scrape still writes latest.json without this.
# Start: docker compose up -d
# Typical local URL (matches docker-compose.yml — not a production secret):
# DATABASE_URL=postgresql://egx:egx@localhost:5432/egx
DATABASE_URL=

# Optional historical ingest (npm run db:ingest-history). RANGE=max|5d|1mo|… or FROM/TO ISO dates.
# RANGE=5d
# FROM=
# TO=
# SYMBOLS=COMI.CA
# LIMIT=3
# PROVIDER=mubasher

# Optional data-quality audit (npm run db:audit-quality). Isolated from live scrape.
# SYMBOLS=COMI.CA
# SOURCE_KIND=csv
